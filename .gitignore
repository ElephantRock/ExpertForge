# ---------------------------------------------------------------------------
# ExpertForge .gitignore
# Large artifacts, generated files, caches, and secrets must never be committed.
# (doctrine/collaboration.md §15; AGENTS.md §6.)
# ---------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# --- Virtual environments (project-local, managed by uv) ---
.venv/
venv/
env/
.uv-cache/

# --- Test / type / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Generated run artifacts (Milestone 0+ creates these) ---
# Checkpoints, logs, metrics, manifests are generated by runs; only schema
# examples and intentionally-tracked fixtures belong in the repo.
runs/
outputs/
artifacts/
# Track the Issue #10 artifact-management source package: the broad `artifacts/`
# rule above is meant for generated run-output directories, not the versioned
# `src/expertforge/artifacts/` import package. Re-exclude Python caches so the
# negation does not pull __pycache__ back in.
!src/expertforge/artifacts/
!src/expertforge/artifacts/**
src/expertforge/artifacts/__pycache__/
checkpoints/
# Track the Issue #11 checkpoint source package: the broad `checkpoints/` rule
# above is meant for generated run-output checkpoint directories, not the
# versioned `src/expertforge/checkpoints/` import package. Re-exclude Python
# caches so the negation does not pull __pycache__ back in.
!src/expertforge/checkpoints/
!src/expertforge/checkpoints/**
src/expertforge/checkpoints/__pycache__/
*.ckpt
*.pt
*.bin
*.safetensors
logs/
*.log
wandb/
mlruns/
tensorboard/

# --- Data and datasets (large; tracked only as provenance records, never blobs) ---
data/
datasets/
!datasets/.gitkeep
*.zip
*.tar
*.tar.gz
*.tgz
*.parquet
*.npy
*.npz

# --- Tokenizer artifacts (large; tracked only as manifests + derivation
#     provenance, never blobs). The corrected tokenizer.json is reproducible
#     from the rejected source via scripts/derive_d0_tokenizer.py; its sha256
#     is bound by tokenizers/manifests/d0-gpt-neox-corrected-v1.json. ---
tokenizers/gpt-neox-corrected-v1/tokenizer.json

# --- Environment / provenance capture that is machine-specific ---
# These are captured per-run into experiments/ or reports/; stray captures:
.env
.env.*
!.env.example

# --- Local acquisition caches (external artifacts per doctrine §9;
#     verified by sha256 against committed manifests before use) ---
.cache/

# --- Secrets (never commit) ---
*.pem
*.key
secrets/
credentials*

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Local agent/session tooling (never committed) ---
.zcode/
